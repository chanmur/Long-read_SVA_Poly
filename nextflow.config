process {
  executor = 'slurm'
  clusterOptions = {''}
  scratch = ''
  errorStrategy = 'ignore'

  withLabel: STRUCTURAL_VARIANT_CALLING {
    container = '/path/sniffles_2.8.0--pyhdfd78af_0'
    clusterOptions = {"-t 10:00:00 -J sv_calling -N 1 -n 32 -o sv_calling_%j.out -e sv_calling_%j.err"}
  }

  withLabel: VCF_PROCESSING {
    clusterOptions = {"-t 05:00:00 -J vcf_proc -N 1 -n 6 -o vcf_proc_%j.out -e vcf_proc_%j.err"}
  }

  withName: COMPRESS_VCF {
    container = '/path/htslib_1.24--ha79157c_0'
  }

  withName: INDEX_VCF {
    container = '/path/tabixpp_1.1.2--hd68fcf3_1'
  }

  withLabel: BCFTOOLS {
    container = '/path/bcftools_1.24--h487d631_0'
  }

  withLabel: TE_ANNOTATIONS {
    clusterOptions = {"-t 15:00:00 -J te_annot -N 1 -n 24 -o te_annot_%j.out -e te_annot_%j.err"}
  }

  withName: REPEATMASK {
    container = '/path/repeatmasker_4.2.4--pl5321hdfd78af_0'
    containerOptions = "--bind ${params.dfam_db_dir}:/usr/local/share/famdb-3.0.0/Libraries/famdb:ro --bind ${params.te_library_dir}:/repeat_library:ro"
    
  }

  withName: REFINE_SVA_ANNOTATIONS {
    module = ['GCC/11.3.0', 'OpenMPI/4.1.4', 'xTea/v0.1.0-long']
  }
}

executor {
    name = 'slurm'
    queueSize = params.queue_size //Queue size is defined in the params.json file
}

singularity {
    enabled = true
    autoMounts = true
}
